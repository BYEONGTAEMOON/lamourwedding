# Copy to .env.local and fill in. Set the same values in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Admin login (/admin)
ADMIN_PASSWORD=
# 16+ random characters, e.g. `openssl rand -base64 32`
ADMIN_SESSION_SECRET=

# 새 신청 알림 메일 (선택). https://resend.com 에서 API 키를 만드세요.
# 도메인을 인증하기 전에는 Resend에 가입한 이메일로만 받을 수 있습니다.
RESEND_API_KEY=
# 받을 이메일. 여러 명이면 쉼표로 구분
NOTIFY_EMAIL=

# 메타 전환 API (선택). 이벤트 관리자 → 픽셀 → 설정 → 전환 API → 액세스 토큰 생성
META_CAPI_TOKEN=
# 확인할 때만: 이벤트 관리자 → 이벤트 테스트의 테스트 코드 (예: TEST12345). 확인 후 지우세요.
META_TEST_EVENT_CODE=
