# Copy to .env.local and fill in. Set the same values in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Admin login (/admin)
ADMIN_PASSWORD=
# 16+ random characters, e.g. `openssl rand -base64 32`
ADMIN_SESSION_SECRET=
